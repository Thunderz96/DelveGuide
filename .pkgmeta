package-as: DelveGuide

# What CurseForge shows as a release's "Changes". Without this the packager
# builds that text from every commit message since the previous tag.
# RELEASE_NOTES.md is the top CHANGELOG.md section, written by
# tools/release_notes.py: run it after editing that section.
manual-changelog:
  filename: RELEASE_NOTES.md
  markup-type: markdown

ignore:
  - .github
  - .gitignore
  - .pkgmeta
  - .claude
  - CHANGELOG.md
  - RELEASE_NOTES.md
  - LICENSE
  - README.md
  - tools

# Libraries are committed under Libs/ and packaged as-is. No externals
# fetched at build time -- the previous URLs (CurseForge git mirrors and
# Stanzilla/LibStub) all 404, and the repo already contains working copies
# of LibStub, CallbackHandler-1.0, LibDataBroker-1.1, and LibDBIcon-1.0.

enable-nolib-creation: no
